diff --git a/engine-mallabi/tests/btt-rampas.test.cjs b/engine-mallabi/tests/btt-rampas.test.cjs
new file mode 100644
index 0000000..4c93305
--- /dev/null
+++ b/engine-mallabi/tests/btt-rampas.test.cjs
@@ -0,0 +1,52 @@
+const test=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const vm=require('node:vm');
+const path=require('node:path');
+
+const root=path.resolve(__dirname,'../..');
+const creator=fs.readFileSync(path.join(root,'src/js/05-creador-tramos.js'),'utf8');
+const btt=fs.readFileSync(path.join(root,'src/js/12-btt.js'),'utf8');
+const ctx=vm.createContext({module:{exports:{}},alturasTerrenoGps:async()=>{}});
+vm.runInContext(creator.split('\n').find(l=>l.startsWith('function metros2('))+'\n'+btt,ctx);
+const {rampasBtt,revisaCandidatasBtt,firmeBtt,textoRevisionBtt}=ctx.module.exports;
+const puntos=(pendiente,base=0)=>Array.from({length:26},(_,i)=>[43+i*20/111195,-2.5,base+i*20*pendiente]);
+const candidato=(points,mode='bike')=>({parts:[points],mode});
+
+test('sustained steep ascent requires confirmation and gives a segment to draw',()=>{
+ const check=rampasBtt([puntos(.31)]);
+ assert.equal(check.alturaIncierta,false);
+ assert.equal(check.tramos.length,1);
+ assert.equal(Math.round(check.tramos[0].pendiente),31);
+ assert(check.tramos[0].puntos.length>4);
+ assert.match(textoRevisionBtt(check),/Probable tramo a pie/);
+});
+test('descending, paved and isolated spikes do not create the loose-terrain warning',()=>{
+ const arriba=puntos(.31);
+ assert.equal(rampasBtt([arriba.toReversed()]).tramos.length,0);
+ assert.equal(rampasBtt([arriba],[{desde:0,hasta:501}]).tramos.length,0);
+ const spike=puntos(0);
+ spike[10][2]=70;
+ assert.equal(rampasBtt([spike]).tramos.length,0);
+});
+test('uncertain elevation is kept behind alternatives with known acceptable elevation',async()=>{
+ const peligrosa=candidato(puntos(.31)), buena=candidato(puntos(.10));
+ const dudosa=candidato(puntos(.10).map(p=>[p[0],p[1],null]));
+ const ordered=await revisaCandidatasBtt([peligrosa,dudosa,buena],new AbortController().signal);
+ assert.deepEqual(Array.from(ordered,x=>x.parts),[buena.parts,dudosa.parts,peligrosa.parts]);
+ assert.match(textoRevisionBtt(ordered[1].revisionBtt),/faltan alturas/);
+});
+test('the ramp across two short legs is still detected',async()=>{
+ const points=puntos(.31).slice(0,12), anterior=points.slice(0,6), nueva=points.slice(6);
+ assert.equal(rampasBtt([nueva]).tramos.length,0);
+ const checked=await revisaCandidatasBtt([candidato(nueva)],new AbortController().signal,anterior);
+ assert.equal(checked[0].revisionBtt.tramos.length,1);
+});
+test('only matched BRouter rows with good pavement exempt a steep section',()=>{
+ const points=puntos(.31), end=points.at(-1);
+ const header=['Longitude','Latitude','Elevation','Distance','WayTags'];
+ const row=[Math.round(end[1]*1e6),Math.round(end[0]*1e6),155,500,'highway=track surface=asphalt'];
+ assert.equal(firmeBtt({...candidato(points),terrain:[header,row]}).length,1);
+ assert.equal(firmeBtt({...candidato(points),terrain:[header,[...row.slice(0,4),'surface=asphalt smoothness=horrible']]}).length,0);
+ assert.equal(firmeBtt({...candidato(points),terrain:[header,[0,...row.slice(1)]]}).length,0);
+});

diff --git a/src/js/12-btt.js b/src/js/12-btt.js
new file mode 100644
index 0000000..83e5e98
--- /dev/null
+++ b/src/js/12-btt.js
@@ -0,0 +1,169 @@
+// El perfil del motor elige caminos. Aquí se comprueba además si la subida
+// es razonable para el modo BTT antes de añadirla o guardarla en el borrador.
+const VENTANA_BTT=200, PENDIENTE_BTT=25, HUECO_ALTURA_BTT=80;
+
+function rampasBtt(parts,firmes=[]){
+ const rows=[];
+ let total=0;
+ for(const part of parts)for(const p of part){
+  const prev=rows.at(-1);
+  if(prev){
+   const delta=metros2(prev.p,p);
+   if(delta<.01)continue;
+   total+=delta;
+  }
+  rows.push({d:total,p});
+ }
+ if(rows.length<2)return {tramos:[],alturaIncierta:true};
+ const alturaIncierta=rows.some((r,i)=>!Number.isFinite(r.p[2])||i>0&&r.d-rows[i-1].d>HUECO_ALTURA_BTT);
+ const tramos=[];
+ let i=0;
+ function mide(d){
+  while(i>0&&rows[i].d>d)i--;
+  while(i+1<rows.length-1&&rows[i+1].d<d)i++;
+  const a=rows[i],b=rows[i+1];
+  const f=(d-a.d)/(b.d-a.d);
+  const p=[a.p[0]+(b.p[0]-a.p[0])*f,a.p[1]+(b.p[1]-a.p[1])*f];
+  const h=f<=1e-6?a.p[2]:f>=1-1e-6?b.p[2]:b.d-a.d<=HUECO_ALTURA_BTT&&Number.isFinite(a.p[2])&&Number.isFinite(b.p[2])?a.p[2]+(b.p[2]-a.p[2])*f:null;
+  return {p,h};
+ }
+ if(total>=VENTANA_BTT){
+  const limite=total-VENTANA_BTT;
+  for(let desde=0;;desde=Math.min(limite,desde+20)){
+   const hasta=desde+VENTANA_BTT;
+   const cotas=[0,50,100,150,200].map(m=>mide(desde+m).h);
+   if(cotas.every(Number.isFinite)){
+    const pendiente=(cotas[4]-cotas[0])/VENTANA_BTT*100;
+    // Dos bloques de subida, para que un salto aislado de altura no baste.
+    const bloques=cotas.slice(1).filter((h,j)=>h-cotas[j]>=5).length;
+    const pavimentado=firmes.some(f=>f.desde<=desde&&f.hasta>=hasta);
+    if(pendiente>=PENDIENTE_BTT&&bloques>=2&&!pavimentado){
+     const anterior=tramos.at(-1);
+     if(anterior&&desde<=anterior.hasta){
+      anterior.hasta=hasta;
+      anterior.pendiente=Math.max(anterior.pendiente,pendiente);
+     }else tramos.push({desde,hasta,pendiente});
+    }
+   }
+   if(desde>=limite)break;
+  }
+ }
+ for(const t of tramos)t.puntos=[mide(t.desde).p,...rows.filter(r=>r.d>t.desde&&r.d<t.hasta).map(r=>r.p.slice(0,2)),mide(t.hasta).p];
+ return {tramos,alturaIncierta};
+}
+
+function firmeBtt(candidate){
+ const messages=candidate.terrain;
+ if(!Array.isArray(messages)||!Array.isArray(messages[0]))return [];
+ const header=messages[0],lng=header.indexOf('Longitude'),lat=header.indexOf('Latitude'),distance=header.indexOf('Distance'),tags=header.indexOf('WayTags');
+ if([lng,lat,distance,tags].some(k=>k<0))return [];
+ const points=candidate.parts[0],firmes=[];
+ let limite=0,indice=0,metros=0,prev=0;
+ for(const row of messages.slice(1)){
+  if(!Array.isArray(row)||!/^\d+$/.test(row[distance]))return [];
+  limite+=Number(row[distance]);
+  const fin=[Number(row[lat])/1e6,Number(row[lng])/1e6];
+  if(!fin.every(Number.isFinite))return [];
+  while(indice<points.length-1&&metros2(points[indice],fin)>4&&metros<limite+50){
+   metros+=metros2(points[indice],points[indice+1]);indice++;
+  }
+  if(metros2(points[indice],fin)>4||Math.abs(metros-limite)>Math.max(30,limite*.04))return [];
+  const tag=String(row[tags]||'');
+  const bueno=/\bsurface=(asphalt|paved|concrete|paving_stones)\b/.test(tag)&&!/\b(highway=steps|smoothness=(very_bad|horrible|very_horrible|impassable)|bicycle=(no|dismount))\b/.test(tag);
+  if(bueno&&metros>prev){
+   const ultimo=firmes.at(-1);
+   if(ultimo&&ultimo.hasta===prev)ultimo.hasta=metros;
+   else firmes.push({desde:prev,hasta:metros});
+  }
+  prev=metros;
+ }
+ return firmes;
+}
+
+function prefijoBtt(points,start){
+ if(points.length<2||metros2(points.at(-1),start)>3)return [];
+ let m=0,i=points.length-1;
+ while(i>0&&m<VENTANA_BTT){
+  m+=metros2(points[i],points[i-1]);i--;
+ }
+ return points.slice(i,-1);
+}
+
+async function revisaCandidatasBtt(candidates,signal,prefijo=[],extremos=null){
+ const revisadas=[];
+ for(const candidate of candidates){
+  if(signal.aborted)break;
+  const firmes=firmeBtt(candidate);
+  const revisar=()=>{
+   if(!prefijo.length)return rampasBtt(candidate.parts,firmes);
+   const inicio=[...prefijo,candidate.parts[0][0]];
+   const m=inicio.slice(1).reduce((sum,p,i)=>sum+metros2(inicio[i],p),0);
+   const revision=rampasBtt([prefijo,...candidate.parts],firmes.map(f=>({desde:f.desde+m,hasta:f.hasta+m})));
+   revision.tramos=revision.tramos.filter(t=>t.hasta>m);
+   return revision;
+  };
+  let revision=revisar();
+  if(revision.alturaIncierta){
+   try{await alturasTerrenoGps(candidate,signal)}catch(e){}
+   revision=revisar();
+  }
+  revisadas.push({...candidate,revisionBtt:revision});
+ }
+ const calidad=r=>r.revisionBtt.tramos.length?2:r.revisionBtt.alturaIncierta?1:0;
+ const ordena=(a,b)=>calidad(a)-calidad(b);
+ const rampas=revisadas.flatMap(r=>r.revisionBtt.tramos);
+ if(extremos&&rampas.length&&revisadas.some(r=>calidad(r)>0)&&!signal.aborted){
+  const motor=window.MallabiMotor;
+  try{
+   const [a,b]=extremos;
+   const centros=rampas.map(r=>r.puntos[Math.floor(r.puntos.length/2)]);
+   const vuelta=await motor.fetchBttDetour(a,b,centros,signal);
+   if(vuelta&&(!prefijo.length||metros2(a,vuelta.parts[0][0])<=3)){
+    vuelta.anchors=[vuelta.parts[0][0],vuelta.parts[0].at(-1)];
+    if(motor.validaAlternativa([a,b],vuelta)){
+     const extra=await revisaCandidatasBtt([vuelta],signal,prefijo);
+     const combinadas=[...revisadas,...extra].sort(ordena);
+     return motor.uniqueAlternatives(combinadas,a,b);
+    }
+   }
+  }catch(e){}
+ }
+ return revisadas.sort(ordena);
+}
+
+function textoRevisionBtt(revision,conKm=true){
+ if(!revision)return '';
+ const r=revision.tramos[0];
+ if(r)return 'Probable tramo a pie · rampa del '+Math.round(r.pendiente)+' %'+(conKm?' · desde el km '+(r.desde/1000).toFixed(2).replace('.',','):'')+(revision.tramos.length>1?' · '+revision.tramos.length+' rampas':'');
+ return revision.alturaIncierta?'BTT sin verificar · faltan alturas para comprobar la pendiente':'';
+}
+
+function capaRampasBtt(revision){
+ return revision?.tramos.map(r=>L.polyline(r.puntos,{color:'#ff6946',weight:9,dashArray:'9 7',interactive:false}))||[];
+}
+
+function confirmaTramoBtt(result,signal){
+ const texto=textoRevisionBtt(result.revisionBtt,false);
+ if(signal.aborted||!texto)return Promise.resolve(!signal.aborted);
+ const capas=capaRampasBtt(result.revisionBtt);
+ const vista=L.featureGroup(capas.length?capas:result.parts.map(p=>L.polyline(p,{color:'#ffad4a',weight:5,dashArray:'9 7',interactive:false}))).addTo(map);
+ map.fitBounds(vista.getBounds(),{padding:[55,90],maxZoom:17});
+ estadoMapaGps(texto+' · Elige si quieres añadir el tramo.');
+ const status=$('plannerStatus');
+ return new Promise(resolve=>{
+  const descarta=document.createElement('button'),incluye=document.createElement('button');
+  for(const b of [descarta,incluye]){b.type='button';b.className='une-recta'}
+  descarta.textContent='Descartar tramo';
+  incluye.textContent='Incluir tramo de todos modos';
+  const fin=acepta=>{
+   signal.removeEventListener('abort',cancela);
+   map.removeLayer(vista);descarta.remove();incluye.remove();resolve(acepta);
+  };
+  const cancela=()=>fin(false);
+  signal.addEventListener('abort',cancela,{once:true});
+  descarta.onclick=cancela;incluye.onclick=()=>fin(true);
+  status.append(descarta,incluye);
+ });
+}
+
+if(typeof module==='object'&&module&&module.exports)module.exports={rampasBtt,firmeBtt,revisaCandidatasBtt,textoRevisionBtt};
